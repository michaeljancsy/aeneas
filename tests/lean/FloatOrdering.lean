    lt_sample
      { time := (Float.ofBits 4611686018427387904), level := (Float32.ofBits 0)
      }
      {
        time := (Float.ofBits 4607182418800017408),
        level := (Float32.ofBits 1056964608)
      }
  massert (¬ b1)
  let i4 ←
    cmp_sample
      { time := (Float.ofBits 0), level := (Float32.ofBits 1065353216) }
      {
        time := (Float.ofBits 9223372036854775808),
        level := (Float32.ofBits 1073741824)
      }
  massert (i4 = (-1)#i32)
  let i5 ←
    cmp_sample { time := nan64, level := (Float32.ofBits 1065353216) }
      {
        time := (Float.ofBits 4607182418800017408),
        level := (Float32.ofBits 1056964608)
      }
  massert (i5 = 2#i32)
  let b2 ←
    lt_sample { time := nan64, level := (Float32.ofBits 1065353216) }
      {
        time := (Float.ofBits 4607182418800017408),
        level := (Float32.ofBits 1056964608)
      }
  massert (¬ b2)
  let b3 ←

        level := (Float32.ofBits 1061158912)
      }
      { time := (Float.ofBits 4611686018427387904), level := (Float32.ofBits 0)
      }
  massert (i3 = (-1)#i32)
  let b ←
    lt_sample
      {
        time := (Float.ofBits 4607182418800017408),
        level := (Float32.ofBits 1056964608)
      }
      { time := (Float.ofBits 4611686018427387904), level := (Float32.ofBits 0)
      }
  massert b

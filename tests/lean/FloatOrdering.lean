/-- [float_ordering::test_partial_cmp64]:
    Source: 'tests/src/float-ordering.rs', lines 110:0-132:1
    Visibility: public -/
def test_partial_cmp64 : Result Unit := do
  let nan ← div64 (Float.ofBits 0) (Float.ofBits 0)
  let inf ← div64 (Float.ofBits 4607182418800017408) (Float.ofBits 0)
  let ninf ← div64 (Float.ofBits 13830554455654793216) (Float.ofBits 0)
  let i ←
    cmp64 (Float.ofBits 4607182418800017408) (Float.ofBits 4611686018427387904)
  massert (i = (-1)#i32)
  let i1 ←
    cmp64 (Float.ofBits 4611686018427387904) (Float.ofBits 4611686018427387904)
  massert (i1 = 0#i32)
  let i2 ←
    cmp64 (Float.ofBits 4613937818241073152) (Float.ofBits 4611686018427387904)
  massert (i2 = 1#i32)
  let i3 ← cmp64 (Float.ofBits 9223372036854775808) (Float.ofBits 0)
  massert (i3 = 0#i32)
  let i4 ← cmp64 (Float.ofBits 0) (Float.ofBits 9223372036854775808)
  massert (i4 = 0#i32)
  let i5 ← cmp64 nan (Float.ofBits 4607182418800017408)
  massert (i5 = 2#i32)
  let i6 ← cmp64 (Float.ofBits 4607182418800017408) nan
  massert (i6 = 2#i32)
  let i7 ← cmp64 nan nan
  massert (i7 = 2#i32)
  let i8 ← cmp64 nan inf
  massert (i8 = 2#i32)
  let i9 ← cmp64 inf inf
  massert (i9 = 0#i32)
  let i10 ← cmp64 ninf inf
  massert (i10 = (-1)#i32)
  let i11 ← cmp64 inf (Float.ofBits 9214871658872686752)
  massert (i11 = 1#i32)
  let i12 ← cmp64 ninf (Float.ofBits 18438243695727462560)
  massert (i12 = (-1)#i32)
  let i13 ←
    cmp64 (Float.ofBits 13832806255468478464)
      (Float.ofBits 13836183955189006336)
  massert (i13 = 1#i32)
  let i14 ← cmp64 (Float.ofBits 1) (Float.ofBits 0)
  massert (i14 = 1#i32)
  let i15 ←
    cmp64 (Float.ofBits 9223372036854775809) (Float.ofBits 9223372036854775808)
  massert (i15 = (-1)#i32)
  let i16 ←
    cmp_generic core.cmp.PartialOrdF64 (Float.ofBits 4607182418800017408) nan
  massert (i16 = 2#i32)
  let i17 ←
    cmp_generic core.cmp.PartialOrdF64 (Float.ofBits 9223372036854775808)
      (Float.ofBits 0)
  massert (i17 = 0#i32)


  let fl4 ← max32 (Float32.neg inf) (Float32.ofBits 4284592614)
  massert (fl4 == (Float32.ofBits 4284592614))
  let r ← max32 nan nan
  massert (r != r)
  let fl5 ←
    clamp32 (Float32.ofBits 3225419776) (Float32.ofBits 3221225472)
      (Float32.ofBits 1065353216)
  massert (fl5 == (Float32.ofBits 3221225472))
  let fl6 ←
    clamp32 (Float32.ofBits 1073741824) (Float32.ofBits 3221225472)
      (Float32.ofBits 1065353216)
  massert (fl6 == (Float32.ofBits 1065353216))
  let fl7 ←
    clamp32 (Float32.ofBits 3212836864) (Float32.ofBits 2147483648)
      (Float32.ofBits 1065353216)
  let b ← is_neg_zero32 fl7
  massert b
  let r1 ←
    clamp32 nan (Float32.ofBits 3221225472) (Float32.ofBits 1065353216)
  massert (r1 != r1)
  let fl8 ←
    mul_add32 (Float32.add (Float32.ofBits 1065353216)
      (Float32.ofBits 872415232)) (Float32.sub (Float32.ofBits 1065353216)
      (Float32.ofBits 872415232)) (Float32.ofBits 3212836864)
  massert (fl8 == (Float32.mul (Float32.neg (Float32.ofBits 872415232))
    (Float32.ofBits 872415232)))
  let fl9 ←
    mul_add32 (Float32.ofBits 1036831949) (Float32.ofBits 1092616192)
      (Float32.ofBits 3212836864)
  massert (fl9 == (Float32.ofBits 847249408))
  let fl10 ←
    mul_add32 (Float32.ofBits 2137108966) (Float32.ofBits 1092616192)
      (Float32.ofBits 4284592614)
  massert (fl10 == inf)

  massert (fl9 == (Float32.ofBits 3740912857))
  let fl10 ← i128_to_f32 (-100000000000000000000000000000000000000)#i128
  massert (fl10 == (Float32.ofBits 4271273625))
  let fl11 ← isize_to_f32 (-30000)#isize

/-! ## `f32` methods on special values (kernel evaluation) -/

/-- Expected results for `x` (and `y` for `copysign`): Rust's, except on NaN inputs, where they
are the model's (canonical NaN, positive sign) and so show where the model departs from Rust:
`to_bits`, the six
classification flags (`is_nan`, `is_infinite`, `is_sign_positive`, `is_sign_negative`,
`is_normal`, `is_subnormal`, bit 0 first), `signum`, `copysign`, `recip`, `from_bits`. -/
def checkf32 (x y : UInt32) (toBits flags signum copysign recip fromBits : Nat) : Bool :=
  let fx := Float32.ofBits x
  let fy := Float32.ofBits y
  let fl := (if core.f32.is_nan fx then 1 else 0) + (if core.f32.is_infinite fx then 2 else 0)
    + (if core.f32.is_sign_positive fx then 4 else 0) + (if core.f32.is_sign_negative fx then 8 else 0)
    + (if core.f32.is_normal fx then 16 else 0) + (if core.f32.is_subnormal fx then 32 else 0)
  (core.f32.to_bits fx).bv.toNat == toBits && fl == flags &&
  (core.f32.to_bits (core.f32.signum fx)).bv.toNat == signum &&
  (core.f32.to_bits (core.f32.copysign fx fy)).bv.toNat == copysign &&
  (core.f32.to_bits (core.f32.recip fx)).bv.toNat == recip &&
  (core.f32.to_bits (core.f32.from_bits ⟨x.toBitVec⟩)).bv.toNat == fromBits

